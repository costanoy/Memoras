{
  "name": "memoras",
  "productName": "Memoras",
  "description": "Diário pessoal privado. Funciona sem internet.",
  "author": "Vinicius Costa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:desktop": "tsc --noEmit && vite build --mode desktop --outDir dist-desktop",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "build:mobile": "tsc --noEmit && vite build --mode mobile --outDir dist-mobile && cap sync android",
    "apk": "npm run build:mobile && node scripts/apk.mjs"
  },
  "build": {
    "appId": "br.com.cyberhat.memoras",
    "productName": "Memoras",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Memoras-Setup.${ext}",
      "shortcutName": "Memoras",
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "github",
      "owner": "costanoy",
      "repo": "Memoras"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
