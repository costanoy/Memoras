rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada pessoa só enxerga e altera as próprias anotações.
    // Sem esta regra o banco fica aberto — é o erro que mais causa vazamento.
    match /users/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Nada mais é acessível pelo aplicativo.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
