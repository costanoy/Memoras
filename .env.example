# Copie este arquivo para ".env" e preencha com os dados do seu projeto Firebase.
# Console do Firebase > Configurações do projeto > Seus aplicativos > Configuração do SDK.
#
# Estes valores NÃO são secretos: eles ficam visíveis no código do site, por design.
# A segurança vem das regras do Firestore (arquivo firestore.rules), não daqui.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
